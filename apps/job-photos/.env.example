# Copy to .env.local for development. Production values are set in Railway by the engineer.

# Public URL of this tool (no trailing slash). Used for links in emails and share pages.
APP_URL=http://localhost:3001

# Shared Supabase project (same values in every tool)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server only. Never NEXT_PUBLIC_. Needed for public share routes, webhooks and scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=

# One sign-in across tools: ".naplesaiagency.com" in production, unset locally.
AUTH_COOKIE_DOMAIN=

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# Where photos are stored: "supabase" (the private job-photos bucket) or "memory" (development
# only; nothing survives a restart). The app refuses "memory" when NODE_ENV=production.
STORAGE_DRIVER=supabase
