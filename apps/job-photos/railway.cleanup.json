{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm turbo build --filter=@speedy/job-photos",
    "watchPatterns": ["apps/job-photos/**", "packages/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @speedy/job-photos cleanup",
    "cronSchedule": "0 8 * * *",
    "restartPolicyType": "NEVER"
  }
}
