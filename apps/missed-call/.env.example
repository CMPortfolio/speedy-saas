# Copy to .env.local for development. Production values are set in Railway by the engineer;
# the full list with notes is in LAUNCH.md.

# Public URL of this tool (no trailing slash). Production: https://missed-call.naplesaiagency.com
APP_URL=http://localhost:3002

# Shared Supabase project (same values in every tool). NEXT_PUBLIC_* are baked in at build time,
# so set them in Railway before the build runs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server only. Never NEXT_PUBLIC_. The webhooks write with it, after the provider signature check.
SUPABASE_SERVICE_ROLE_KEY=

# One sign-in across tools: ".naplesaiagency.com" in production, unset locally.
AUTH_COOKIE_DOMAIN=

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# Texting (@speedy/sms). "fake" never contacts a provider and is refused in production
# and on Railway. Production: SMS_PROVIDER=twilio.
SMS_PROVIDER=fake
# Twilio console, Account info. Server only; the auth token also signs every webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: send through a Messaging Service (MG...) instead of the line's own number.
TWILIO_MESSAGING_SERVICE_SID=
# REQUIRED in production: the public origin Twilio posts webhooks to, because the signature
# covers the exact URL. Production: https://missed-call.naplesaiagency.com
SMS_WEBHOOK_PUBLIC_URL=

# Local e2e only: lets a production build run the fake SMS provider, and only when APP_URL is
# localhost. Never set on Railway.
# ALLOW_FAKE_SMS=1

# Set by Railway, not by hand: PORT (the port to listen on) and RAILWAY_ENVIRONMENT.
# NODE_ENV=production is set by `next start`.
