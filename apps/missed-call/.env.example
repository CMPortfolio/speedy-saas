# Copy to .env.local for development. Production values are set in Railway by the engineer.

# Public URL of this tool (no trailing slash). Used for links in emails and share pages.
APP_URL=http://localhost:3001

# Shared Supabase project (same values in every tool)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server only. Never NEXT_PUBLIC_. Needed for public share routes, webhooks and scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=

# One sign-in across tools: ".naplesaiagency.com" in production, unset locally.
AUTH_COOKIE_DOMAIN=

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# Texting (@speedy/sms). "fake" never contacts a provider and is refused in production.
# Twilio is the default assumption until the provider is picked; see packages/sms/README.md.
SMS_PROVIDER=fake
# Twilio console → Account info. Server only; the auth token also signs every webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: send through a Messaging Service (MG…) instead of a fixed from number.
TWILIO_MESSAGING_SERVICE_SID=
# Optional: public origin webhooks are signed against, only when it differs from APP_URL.
SMS_WEBHOOK_PUBLIC_URL=
