# Copy to .env.local for development. Production values are set in Railway by the engineer.

# Public URL of this tool (no trailing slash). Used for links in emails and share pages.
APP_URL=http://localhost:3003

# Shared Supabase project (same values in every tool)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server only. Never NEXT_PUBLIC_. Needed for public share routes, webhooks and scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=

# One sign-in across tools: ".naplesaiagency.com" in production, unset locally.
AUTH_COOKIE_DOMAIN=

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# Texting. fake (default) never contacts anyone and is refused in production.
SMS_PROVIDER=fake
# Development with SMS_PROVIDER=fake only: the made-up number the dev tools give an owner. Real
# owners each have their own texting number in rain_day.owner_settings.sender_number (admin-set).
SMS_FROM_NUMBER=+12395550100
# Twilio, only when SMS_PROVIDER=twilio. Server only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Public origin delivery webhooks are signed against, when it differs from APP_URL.
SMS_WEBHOOK_PUBLIC_URL=
