# Copy to .env.local for development. Production values are set in Railway by the engineer;
# the full list with notes is in LAUNCH.md.

# Public URL of this tool (no trailing slash). REQUIRED in production, because the texting
# provider signs webhooks against it. Production: https://rain-day.naplesaiagency.com
APP_URL=http://localhost:3003

# Shared Supabase project (same values in every tool). NEXT_PUBLIC_* are baked in at build time,
# so set them in Railway before the build runs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server only. Never NEXT_PUBLIC_. The webhooks and the send step write with it, after checks.
SUPABASE_SERVICE_ROLE_KEY=

# One sign-in across tools: ".naplesaiagency.com" in production, unset locally.
AUTH_COOKIE_DOMAIN=
# Same value for the browser client. NEXT_PUBLIC_ vars are baked in at build time, so set it
# in Railway before the build runs.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# Texting (@speedy/sms). "fake" never contacts a provider and is refused in production
# and on Railway. Production: SMS_PROVIDER=twilio.
SMS_PROVIDER=fake
# Development with SMS_PROVIDER=fake only: the made-up number the dev tools give an owner. Real
# owners each have their own texting number in rain_day.owner_settings.sender_number (admin-set).
# Leave unset in production.
SMS_FROM_NUMBER=+12395550100
# Twilio console, Account info. Server only; the auth token also signs every webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Leave EMPTY in production: Twilio ignores each owner's `from` number when this is set, and every
# owner needs their own Messaging Service (see LAUNCH.md).
TWILIO_MESSAGING_SERVICE_SID=
# Optional: the public origin Twilio posts webhooks to, when it differs from APP_URL. The signature
# covers the exact URL; with neither set in production the app answers webhooks with 500.
SMS_WEBHOOK_PUBLIC_URL=

# Local e2e only: lets a production build run the fake SMS provider (playwright.config.ts sets it
# for its own server). Never set on Railway.
# ALLOW_FAKE_SMS=1

# Build and test switches, never set on Railway:
#   SKIP_ENV_VALIDATION=1  lets a build run without these variables (CI builds only)
#   CI=1                   makes the e2e test fail instead of skip when Supabase is missing

# Set by Railway or Next, not by hand: PORT (the port to listen on), RAILWAY_ENVIRONMENT,
# NODE_ENV (production under `next start`) and NEXT_PHASE.
