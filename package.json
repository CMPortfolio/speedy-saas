{
  "name": "speedy-saas",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "new-tool": "tsx scripts/new-tool.ts",
    "db:types": "pnpm --filter @speedy/db db:types"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  }
}
